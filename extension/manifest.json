{
  "manifest_version": 3,
  "name": "ReachOwl Social Browser Bridge",
  "version": "1.0.0",
  "description": "Mendeteksi status login akun Facebook dan Instagram secara otomatis untuk ReachOwl.",
  "permissions": [
    "cookies",
    "storage",
    "tabs",
    "alarms"
  ],
  "host_permissions": [
    "https://*.facebook.com/*",
    "https://*.instagram.com/*",
    "http://localhost:3000/*",
    "http://127.0.0.1:3000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost:3000/*",
        "http://127.0.0.1:3000/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "ReachOwl Social Bridge"
  }
}
